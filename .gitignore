# Virtual environments
.venv/
venv/
env/
.env/

# Environment variables
.env

# Live API credentials. This repository is public; the key must never be committed.
GUARDIAN_API_KEY.txt

# Staging area for files pulled out of the project, pending manual relocation.
Unwanted_files/

# Data (all raw, processed, and output files)
data/

# Large regenerable datasets kept at the repo root rather than under data/.
# The dashboard does not read either: serve.py loads the external data tree
# (LLOYDS_DATA), and the similarly named file it does use is
# data/processed/filtered_bb_sme_sectors_all_status_2026-08-01.csv, not this one.
# Both are rebuilt by notebooks/01_companies_house.ipynb.
filtered_bb_sme_sectors.csv
notebooks/BasicCompanyDataAsOneFile-2026-06-01.csv

# Draft code/notebooks
drafts/

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp

# Lloyds brand assets. Kept local: this repository is public and these are
# trademarked marks. The dashboard renders without them.
dashboard/Lloyds_Banking_Group_Logo.png
dashboard/Lloyds-Bank-Symbol.png
dashboard/assets/horse-mark.png

# The handbook and the design doc are generated from their markdown by
# dashboard/build_handbook.py. Only the .md source and the printed .pdf are versioned;
# the intermediate HTML is a build artefact and is rebuilt on demand.
# Named one by one on purpose: dashboard/index.html IS the dashboard and must stay tracked.
dashboard/dashboard_handbook.html
dashboard/dashboard_design.html
 # Branded intro clip. Kept local, removed from the public repo alongside the # logo and horse marks above. dashboard/Lloyds_intro.mp4 # Same build-artefact rule as the handbook and design doc. dashboard/dashboard_manual.html # Zip of handbook_img/, whose PNGs are already tracked individually. dashboard/handbook_img.zip
